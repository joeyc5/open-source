# Read path, used by the website. Server-only: no NEXT_PUBLIC_ prefix needed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Write path, used only by `npm run ingest`. Bypasses row level security.
# Keep it in GitHub Actions secrets and your local .env, never in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Canonical origin for sitemaps and OpenGraph once you have a domain.
# NEXT_PUBLIC_SITE_URL=https://example.com
